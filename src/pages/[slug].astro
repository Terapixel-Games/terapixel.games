---
import BaseLayout from '../layouts/BaseLayout.astro';
import KeepPageWheelScroll from '../components/KeepPageWheelScroll.astro';
import PlayerFullscreenController from '../components/PlayerFullscreenController.astro';
import games from '../data/games.json';
import type { Game } from '../types';
import { addBuildVersion, withBasePath } from '../lib/site-paths';

export function getStaticPaths() {
  const gameList = games as Game[];
  const playableGames = gameList.filter((game) => (game.embedUrl || game.fullScreenUrl) && !game.isComingSoon);
  return playableGames.map((game) => ({
    params: { slug: game.slug },
    props: { game, allGames: playableGames }
  }));
}

const { game, allGames } = Astro.props as { game: Game; allGames: Game[] };
const buildVersion = import.meta.env.PUBLIC_TPX_BUILD_ID;
const mapPlayableUrl = (value: string | null): string | null => {
  if (!value) return null;
  if (value.startsWith('/')) {
    const baseAwareUrl = withBasePath(value);
    return value.startsWith('/play/') ? addBuildVersion(baseAwareUrl, buildVersion) : baseAwareUrl;
  }
  return value;
};

const embedUrl = mapPlayableUrl(game.embedUrl);
const showEmbed = Boolean(embedUrl) && !game.isComingSoon;
const isPortraitEmbed = game.embedOrientation === 'portrait';

const fallbackIntro = `${game.title} is a browser game from Terapixel Games with quick sessions and accessible gameplay.`;
const fallbackDetails =
  'Play in your browser, use fullscreen when you want more room, and come back for another run when you want to improve.';
const fallbackHowToPlay = `Launch ${game.title}, learn the core loop, and improve performance over repeated sessions.`;
const fallbackFeatures = ['Instant browser play', 'Short sessions with replay value', 'Works well on modern desktop and mobile browsers'];

const seoIntro = game.seoIntro ?? fallbackIntro;
const seoDetails = game.seoDetails ?? fallbackDetails;
const seoHowToPlay = game.seoHowToPlay ?? fallbackHowToPlay;
const seoFeatures = game.seoFeatures ?? fallbackFeatures;
const designNotes = game.designNotes;
const controls = game.controls ?? [];
const playerTips = game.playerTips ?? [];
const guideSections = game.guideSections ?? [];
const faq = game.faq ?? [];

const metaDescription = `${seoIntro} ${seoDetails}`.slice(0, 158);
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/${game.slug}`, siteBase).toString();
const imageUrl = new URL(game.image, siteBase).toString();
const playableGames = allGames.filter((candidate) => (candidate.embedUrl || candidate.fullScreenUrl) && !candidate.isComingSoon);
const relatedGames = allGames
  .filter((candidate) => candidate.slug !== game.slug && Boolean(candidate.embedUrl || candidate.fullScreenUrl) && !candidate.isComingSoon)
  .slice(0, 3);

const videoGameJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  url: canonicalUrl,
  image: imageUrl,
  description: metaDescription,
  gamePlatform: 'Web Browser',
  applicationCategory: 'Game',
  operatingSystem: 'Any',
  publisher: {
    '@type': 'Organization',
    name: 'Terapixel Games'
  },
  isAccessibleForFree: true
};

const faqJsonLd =
  faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((entry) => ({
          '@type': 'Question',
          name: entry.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: entry.answer
          }
        }))
      }
    : null;
---

<BaseLayout
  title={game.title}
  description={metaDescription}
  image={game.image}
  enableAds={showEmbed}
  noindex={!showEmbed}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(videoGameJsonLd)} />
  {faqJsonLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <section class="play-shell is-game-first" data-accent={game.accent ?? 'signal'} aria-labelledby="game-title" data-player-shell>
    <div class:list={['play-frame-shell', isPortraitEmbed && 'is-portrait']} data-page-wheel-scroll>
      {
        showEmbed ? (
          <iframe
            src={embedUrl as string}
            title={`${game.title} game`}
            loading="eager"
            allow="fullscreen; display-capture; microphone"
            allowfullscreen
          />
        ) : (
          <div class="coming-soon-stage">
            <img src={withBasePath(game.image)} alt={game.title} />
            <div>
              <span>Coming soon</span>
              <strong>{game.title}</strong>
              <p>{seoIntro}</p>
            </div>
          </div>
        )
      }
    </div>

    <div class="play-toolbar" aria-label={`${game.title} controls`}>
      <a href={withBasePath('/')} class="portal-brand-lockup">
        <span class="portal-led" aria-hidden="true"></span>
        <span>Games</span>
      </a>
      <nav class="portal-game-tabs" aria-label="Switch playable game">
        {playableGames.map((playableGame) => (
          <a href={withBasePath(`/${playableGame.slug}`)} class:list={['portal-tab', playableGame.slug === game.slug && 'is-active']}>
            {playableGame.title}
          </a>
        ))}
      </nav>
      <div class="portal-toolbar-actions">
        <button type="button" class="portal-tool-button" data-auth-open aria-haspopup="dialog" aria-controls="tpx-auth-modal">Login</button>
        {showEmbed && (
          <button type="button" class="portal-tool-button" data-player-fullscreen>
            Fullscreen
          </button>
        )}
        <a href="#game-info" class="portal-tool-button muted">Info</a>
      </div>
    </div>

    <div class="play-title-row">
      <div>
        <p class="portal-kicker">{showEmbed ? 'Playable now' : 'Cabinet warming up'}</p>
        <h1 id="game-title">{game.title}</h1>
      </div>
      <div class="portal-meta-row">
        {game.genre && <span>{game.genre}</span>}
        {game.mood && <span>{game.mood}</span>}
        <span>{showEmbed ? 'Play in browser' : 'Coming soon'}</span>
      </div>
    </div>
  </section>

  <div id="game-info" class="shell stack below-play">
    <section class="content-grid" aria-label="Game details">
      <article class="glass-panel text-panel">
        <p class="portal-kicker">Why play</p>
        <h2>The Hook</h2>
        <p>{seoDetails}</p>
      </article>

      <article class="glass-panel text-panel">
        <p class="portal-kicker">How to play</p>
        <h2>Your First Run</h2>
        <p>{seoHowToPlay}</p>
        <ul class="product-list">
          {seoFeatures.map((feature) => <li>{feature}</li>)}
        </ul>
      </article>
    </section>

    {
      (designNotes || controls.length > 0 || playerTips.length > 0) && (
        <section class="content-grid" aria-label={`${game.title} player guide`}>
          {designNotes && (
            <article class="glass-panel text-panel">
              <p class="portal-kicker">What matters</p>
              <h2>What to Watch</h2>
              <p>{designNotes}</p>
            </article>
          )}

          {controls.length > 0 && (
            <article class="glass-panel text-panel">
              <p class="portal-kicker">Controls</p>
              <h2>Controls</h2>
              <ul class="product-list">
                {controls.map((control) => <li>{control}</li>)}
              </ul>
            </article>
          )}

          {playerTips.length > 0 && (
            <article class="glass-panel text-panel">
              <p class="portal-kicker">Player tips</p>
              <h2>Improve Your Run</h2>
              <ul class="product-list">
                {playerTips.map((tip) => <li>{tip}</li>)}
              </ul>
            </article>
          )}
        </section>
      )
    }

    {
      guideSections.length > 0 && (
        <section aria-labelledby="guide-heading" class="stack">
          <div class="section-head">
            <p class="portal-kicker">Player guide</p>
            <h2 id="guide-heading" class="section-title">{game.title} Strategy Notes</h2>
          </div>
          <div class="content-grid">
            {guideSections.map((section) => (
              <article class="glass-panel text-panel">
                <h3>{section.heading}</h3>
                <p>{section.copy}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      faq.length > 0 && (
        <section aria-labelledby="faq-heading" class="stack">
          <h2 id="faq-heading" class="section-title">
            {game.title} FAQ
          </h2>
          <div class="faq-list">
            {faq.map((entry) => (
              <article class="glass-panel faq-item">
                <h3>{entry.question}</h3>
                <p>{entry.answer}</p>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      relatedGames.length > 0 && (
        <section aria-labelledby="related-games-heading" class="stack">
          <h2 id="related-games-heading" class="section-title">
            Related Games
          </h2>
          <div class="related-grid">
            {relatedGames.map((relatedGame) => (
              <a href={withBasePath(`/${relatedGame.slug}`)} class="related-link">
                <strong>{relatedGame.title}</strong>
                <span>{relatedGame.genre ?? 'View details'}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <KeepPageWheelScroll />
  <PlayerFullscreenController />
</BaseLayout>
