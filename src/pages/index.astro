---
import BaseLayout from '../layouts/BaseLayout.astro';
import DeferredFeaturedPlayer from '../components/DeferredFeaturedPlayer.astro';
import GameCard from '../components/GameCard.astro';
import KeepPageWheelScroll from '../components/KeepPageWheelScroll.astro';
import PlayerFullscreenController from '../components/PlayerFullscreenController.astro';
import games from '../data/games.json';
import type { Game } from '../types';
import { addBuildVersion, withBasePath } from '../lib/site-paths';

const gameList = games as Game[];
const playableGames = gameList.filter((game) => (game.embedUrl || game.fullScreenUrl) && !game.isComingSoon);
const buildVersion = import.meta.env.PUBLIC_TPX_BUILD_ID;
const primaryGame = playableGames[0] ?? gameList[0];
const mapPlayableUrl = (value: string | null): string | null => {
  if (!value) return null;
  if (value.startsWith('/')) {
    const baseAwareUrl = withBasePath(value);
    return value.startsWith('/play/') ? addBuildVersion(baseAwareUrl, buildVersion) : baseAwareUrl;
  }
  return value;
};

const primaryEmbedUrl = mapPlayableUrl(primaryGame.embedUrl);
const isPrimaryPortrait = primaryGame.embedOrientation === 'portrait';
---

<BaseLayout
  title="Games"
  description="Browse free Terapixel browser games you can play now."
  enableAds={true}
>
  <section class="play-shell is-game-first" data-accent={primaryGame.accent ?? 'signal'} aria-labelledby="games-heading" data-player-shell>
    <div class:list={['play-frame-shell', isPrimaryPortrait && 'is-portrait']} data-page-wheel-scroll>
      {
        primaryEmbedUrl ? (
          <DeferredFeaturedPlayer title={primaryGame.title} image={primaryGame.image} embedUrl={primaryEmbedUrl} />
        ) : (
          <img src={withBasePath(primaryGame.image)} alt={primaryGame.title} />
        )
      }
    </div>

    <div class="play-toolbar" aria-label="Featured game controls">
      <a href={withBasePath('/')} class="portal-brand-lockup">
        <span class="portal-led" aria-hidden="true"></span>
        <span>Games</span>
      </a>
      <nav class="portal-game-tabs" aria-label="Switch featured game">
        {playableGames.map((game) => (
          <a href={withBasePath(`/${game.slug}`)} class:list={['portal-tab', game.slug === primaryGame.slug && 'is-active']}>
            {game.title}
          </a>
        ))}
      </nav>
      <div class="portal-toolbar-actions">
        <button type="button" class="portal-tool-button" data-auth-open aria-haspopup="dialog" aria-controls="tpx-auth-modal">Login</button>
        {primaryEmbedUrl && (
          <button type="button" class="portal-tool-button" data-player-fullscreen disabled>
            Fullscreen
          </button>
        )}
        <a href="#playable-games-heading" class="portal-tool-button muted">Library</a>
      </div>
    </div>

    <div class="play-title-row">
      <div>
        <p class="portal-kicker">Featured game</p>
        <h1 id="games-heading">{primaryGame.title}</h1>
      </div>
      <div class="portal-meta-row">
        {primaryGame.genre && <span>{primaryGame.genre}</span>}
        {primaryGame.mood && <span>{primaryGame.mood}</span>}
        <span>{playableGames.length} games</span>
      </div>
    </div>
  </section>

  <div class="shell stack below-play">
    <section class="section-block" aria-labelledby="playable-games-heading">
      <div class="section-head split-head">
        <div>
          <p class="portal-kicker">Ready now</p>
          <h2 id="playable-games-heading" class="section-title">Games You Can Play</h2>
        </div>
        <p class="section-copy">Use fullscreen for the biggest play area, or open the details page first for controls and tips.</p>
      </div>
      <div class="game-grid arcade-grid">
        {playableGames.map((game) => (
          <div id={game.genre ? String(game.genre).toLowerCase().replaceAll(' ', '-') : undefined}>
            <GameCard game={game} />
          </div>
        ))}
      </div>
    </section>

    <section class="section-block" aria-labelledby="quality-heading">
      <div class="section-head">
        <p class="portal-kicker">What to expect</p>
        <h2 id="quality-heading" class="section-title">Quick Games, Clear Goals</h2>
      </div>
      <div class="content-grid">
        <article class="glass-panel text-panel">
          <h3>Start Fast</h3>
          <p>
            Each listed game is ready to open from the browser. Most sessions are short, so it is easy to retry and
            chase a better score, lap, or time.
          </p>
        </article>
        <article class="glass-panel text-panel">
          <h3>Read Less, Play More</h3>
          <p>
            Game pages keep the instructions practical: what you are trying to do, how to control the game, and what to
            practice when you want to improve.
          </p>
        </article>
      </div>
    </section>
  </div>

  <KeepPageWheelScroll />
  <PlayerFullscreenController />
</BaseLayout>
